{
  "name": "dsh-quark",
  "version": "0.1.0",
  "description": "夸克网盘接入 DeepSeek Harness：侧边栏浏览、搜索、分享与文件操作，并让 agent 通过官方 quarkclouddrive CLI 直接读写网盘",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "quark",
    "quark-drive",
    "夸克网盘",
    "cloud-drive"
  ],
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bennie96/dsh-quark.git"
  },
  "bugs": {
    "url": "https://github.com/Bennie96/dsh-quark/issues"
  },
  "homepage": "https://github.com/Bennie96/dsh-quark#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
